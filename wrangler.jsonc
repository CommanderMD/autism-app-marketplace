{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autism-app-marketplace",
  "main": "src/worker.js",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autism-app-marketplace-db",
      "database_id": "5d6310a8-c1bb-4b5c-ab04-4f2eff5528f2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "50e1713d34f046c0bfe47283f831d51d"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
